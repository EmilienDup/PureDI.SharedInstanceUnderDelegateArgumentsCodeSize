<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- writes the generated composition under obj/Debug/net10.0/generated/Pure.DI -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- dotnet build -p:PureDIVersion=<version> to try another package version -->
    <PureDIVersion Condition="'$(PureDIVersion)' == ''">2.5.7</PureDIVersion>
    <!-- -p:LetFunc=true: bind Func<T1, T> with ctx.Let instead of using the built-in binding (ctx.Override) -->
    <DefineConstants Condition="'$(LetFunc)' == 'true'">$(DefineConstants);LET_FUNC</DefineConstants>
    <!-- -p:LocalFunctionsOn=true: .Hint(Hint.LocalFunctions, "On") -->
    <DefineConstants Condition="'$(LocalFunctionsOn)' == 'true'">$(DefineConstants);LOCAL_FUNCTIONS_ON</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Pure.DI" Version="[$(PureDIVersion)]" PrivateAssets="all" />
  </ItemGroup>
</Project>
